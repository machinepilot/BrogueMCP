## Game Loop

Implement a clean game loop that separates update and render:

```c
void gameLoop() {
    bool running = true;
    double lastTime = getTime();
    
    while (running) {
        double currentTime = getTime();
        double deltaTime = currentTime - lastTime;
        lastTime = currentTime;
        
        // Process input (non-blocking)
        Event event;
        while (pollEvent(&event)) {
            if (event.type == EVENT_QUIT) {
                running = false;
            }
            handleEvent(&event);
        }
        
        // Update game state
        updateGame(deltaTime);
        
        // Render
        renderGame();
        
        // Cap frame rate if needed
        sleepIfNeeded();
    }
}
```

## Saving and Loading

Implement a robust save/load system:

```c
// Save game state to file
bool saveGame(GameState* state, const char* filename) {
    FILE* file = fopen(filename, "wb");
    if (!file) {
        return false;
    }
    
    // Write header
    SaveHeader header;
    header.version = SAVE_VERSION;
    header.seed = state->seed;
    fwrite(&header, sizeof(SaveHeader), 1, file);
    
    // Write game state
    serializeGameState(state, file);
    
    fclose(file);
    return true;
}

// Load game state from file
GameState* loadGame(const char* filename) {
    FILE* file = fopen(filename, "rb");
    if (!file) {
        return NULL;
    }
    
    // Read and validate header
    SaveHeader header;
    fread(&header, sizeof(SaveHeader), 1, file);
    
    if (header.version != SAVE_VERSION) {
        fclose(file);
        return NULL;  // Incompatible version
    }
    
    // Create and load game state
    GameState* state = createGameState();
    state->seed = header.seed;
    
    deserializeGameState(state, file);
    
    fclose(file);
    return state;
}
```

## Memory Management

Implement consistent patterns for game resources:

```c
// Create game state
GameState* createGameState() {
    GameState* state = malloc(sizeof(GameState));
    if (!state) {
        return NULL;
    }
    
    // Initialize fields
    state->map = NULL;
    state->entities = NULL;
    state->entityCount = 0;
    state->entityCapacity = 0;
    
    return state;
}

// Destroy game state and free all resources
void destroyGameState(GameState* state) {
    if (!state) {
        return;
    }
    
    // Free map
    if (state->map) {
        for (int y = 0; y < state->mapHeight; y++) {
            free(state->map[y]);
        }
        free(state->map);
    }
    
    // Free entities
    for (int i = 0; i < state->entityCount; i++) {
        destroyEntity(state->entities[i]);
    }
    free(state->entities);
    
    // Free state itself
    free(state);
}
```

By following these patterns and best practices, you can create a well-structured and maintainable roguelike game in BrogueMCP that follows established conventions while allowing for innovation and experimentation.