# Memory Management Implementation Examples

This rule provides practical examples of implementing the memory management protocol within the BrogueMCP project.

## Knowledge Graph Storage Example

### Python Implementation

```python
from knowledge_graph import KnowledgeGraph, Entity, Relationship, Metadata

# Initialize the graph manager
graph = KnowledgeGraph(storage_path="memory-bank/knowledge")

# Create a new entity with metadata
def add_monster(name, attributes, sources=None):
    # Check if entity already exists
    existing = graph.query(f"MATCH (m:Monster {{name: '{name}'}}) RETURN m")
    
    if existing:
        # Update existing entity
        monster_id = existing[0]['m'].id
        for key, value in attributes.items():
            graph.update_property(monster_id, key, value)
    else:
        # Create new entity
        metadata = Metadata(
            created=time.time(),
            source=sources or ["user_creation"],
            confidence=1.0,
            version="1.0"
        )
        
        # Create the entity
        monster = Entity(
            type="Monster",
            properties={"name": name, **attributes},
            metadata=metadata
        )
        monster_id = graph.add_entity(monster)
    
    return monster_id

# Create relationships between entities
def relate_entities(source_id, target_id, relationship_type, properties=None):
    # Create the relationship
    relationship = Relationship(
        source_id=source_id,
        target_id=target_id,
        type=relationship_type,
        properties=properties or {},
        metadata=Metadata(
            created=time.time(),
            source=["user_creation"],
            confidence=1.0
        )
    )
    
    relationship_id = graph.add_relationship(relationship)
    return relationship_id

# Example usage
monster_id = add_monster(
    name="Ancient Dragon",
    attributes={
        "type": "Fire",
        "species": "Dragon",
        "difficulty": 8
    },
    sources=["level_generator"]
)

location_id = graph.query("MATCH (l:Location {name: 'Treasure Chamber'}) RETURN l")[0]['l'].id

# Create relationship
relate_entities(
    source_id=monster_id,
    target_id=location_id,
    relationship_type="GUARDS",
    properties={"spawn_rate": "0.75"}
)
```

### C Implementation

```c
#include "knowledge_graph.h"
#include "memory_manager.h"

// Initialize the graph manager
KnowledgeGraph* create_graph_manager(const char* storage_path) {
    KnowledgeGraph* graph = kg_create();
    
    if (!graph) {
        fprintf(stderr, "Failed to create knowledge graph\n");
        return NULL;
    }
    
    if (kg_set_storage_path(graph, storage_path) != KG_SUCCESS) {
        fprintf(stderr, "Failed to set storage path\n");
        kg_destroy(graph);
        return NULL;
    }
    
    return graph;
}

// Add an entity to the graph
EntityID add_entity(
    KnowledgeGraph* graph,
    const char* type,
    const PropertyMap* properties,
    const char* source
) {
    Metadata metadata;
    memset(&metadata, 0, sizeof(Metadata));
    
    metadata.creation_time = time(NULL);
    metadata.source = source;
    metadata.confidence = 1.0;
    
    EntityID entity_id = kg_add_entity(graph, type, properties, &metadata);
    
    if (entity_id == KG_INVALID_ID) {
        fprintf(stderr, "Failed to add entity\n");
        return KG_INVALID_ID;
    }
    
    return entity_id;
}

// Add a relationship between entities
RelationshipID add_relationship(
    KnowledgeGraph* graph,
    EntityID source_id,
    EntityID target_id,
    const char* relationship_type,
    const PropertyMap* properties
) {
    Metadata metadata;
    memset(&metadata, 0, sizeof(Metadata));
    
    metadata.creation_time = time(NULL);
    metadata.source = "system";
    metadata.confidence = 1.0;
    
    RelationshipID rel_id = kg_add_relationship(
        graph,
        source_id,
        target_id,
        relationship_type,
        properties,
        &metadata
    );
    
    if (rel_id == KG_INVALID_ID) {
        fprintf(stderr, "Failed to add relationship\n");
        return KG_INVALID_ID;
    }
    
    return rel_id;
}

// Example usage
void example_usage() {
    KnowledgeGraph* graph = create_graph_manager("memory-bank/knowledge");
    
    if (!graph) {
        return;
    }
    
    // Create property map
    PropertyMap* props = kg_create_property_map();
    kg_property_map_add(props, "name", "Goblin Scout");
    kg_property_map_add(props, "species", "Goblin");
    kg_property_map_add(props, "level", "1");
    
    // Add entity
    EntityID monster_id = add_entity(graph, "Monster", props, "dungeon_level_1");
    kg_destroy_property_map(props);
    
    // Create relationship
    props = kg_create_property_map();
    kg_property_map_add(props, "spawn_time", "Level 1");
    
    // Find the item entity by querying
    QueryResult* result = kg_query(graph, "MATCH (i:Item {name: 'Rusty Dagger'}) RETURN i");
    EntityID item_id = KG_INVALID_ID;
    
    if (result && result->count > 0) {
        item_id = result->entities[0].id;
        add_relationship(graph, monster_id, item_id, "CARRIES", props);
    }
    
    kg_destroy_property_map(props);
    kg_destroy_query_result(result);
    kg_destroy(graph);
}
```

## Integration with Procedural Generation

The memory management system integrates with the procedural generation system through:

1. Automatic entity extraction during dungeon generation
2. Knowledge graph queries during procedural content creation
3. Persistent storage of successful generation patterns

See `../game/procedural-generation.mdc` for more details on procedural generation integration.

## Query Examples

```python
def find_related_entities(graph, entity_name, relationship_type=None):
    """Find entities related to the given entity name."""
    query = f"""
    MATCH (e)-[r]->(related)
    WHERE e.name = '{entity_name}'
    """
    
    if relationship_type:
        query += f"AND type(r) = '{relationship_type}' "
    
    query += "RETURN related"
    
    results = graph.query(query)
    return [record['related'] for record in results]

def find_shared_relationships(graph, entity1_name, entity2_name):
    """Find entities that both given entities are related to."""
    query = f"""
    MATCH (e1)-[r1]->(shared)<-[r2]-(e2)
    WHERE e1.name = '{entity1_name}' AND e2.name = '{entity2_name}'
    RETURN shared
    """
    
    results = graph.query(query)
    return [record['shared'] for record in results]

def explore_related_entities(graph, entity_id, max_depth=2, relationship_types=None):
    """Explore the graph around an entity up to a certain depth."""
    query = f"""
    MATCH path = (e)-[r*1..{max_depth}]-(related)
    WHERE id(e) = {entity_id}
    """
    
    if relationship_types:
        relationship_filter = ' OR '.join([f"type(r) = '{t}'" for t in relationship_types])
        query += f"AND ({relationship_filter}) "
    
    query += "RETURN related"
    
    results = graph.query(query)
    return [record['related'] for record in results]
```

## Memory Bank Integration

```python
from memory_bank import MemoryBank

# Initialize memory bank with knowledge graph backend
memory = MemoryBank(backend="knowledge_graph", storage_path="memory-bank/storage")

# Store procedural generation parameters
def store_generation_parameters(name, parameters, success_metrics=None):
    """Store parameters from successful procedural generation."""
    # Check if similar parameters already exist
    existing = memory.query(
        collection="generation_parameters",
        filter={"name": name}
    )
    
    # Store with metadata
    memory.store(
        collection="generation_parameters",
        data={
            "name": name,
            "parameters": parameters,
            "success_metrics": success_metrics,
            "timestamp": time.time()
        },
        metadata={
            "version": "1.0",
            "source": "procgen_module"
        }
    )

# Retrieve generation parameters
def get_generation_parameters(name, filters=None):
    """Retrieve stored generation parameters."""
    query_filter = {"name": name}
    
    # Add additional filters if provided
    if filters:
        query_filter.update(filters)
    
    parameters = memory.query(
        collection="generation_parameters",
        filter=query_filter,
        sort={"timestamp": "desc"},
        limit=1
    )
    
    return parameters[0] if parameters else None

# Example usage
dungeon_params = {
    "room_count": 15,
    "connection_density": 0.7,
    "features": ["traps", "hidden_doors", "treasure_rooms"],
    "difficulty": "medium"
}

# Store successful parameters
store_generation_parameters(
    name="haunted_dungeon",
    parameters=dungeon_params,
    success_metrics={
        "player_satisfaction": 0.85,
        "completion_time": 45,
        "death_rate": 0.3
    }
)

# Retrieve for later use
params = get_generation_parameters("haunted_dungeon")
```